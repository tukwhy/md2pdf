{
  "name": "md2pdf",
  "displayName": "MD2PDF - Markdown to PDF",
  "description": "一键将 Markdown 转换为出版级中文 PDF，完美支持 LaTeX 公式、长代码折行与相对路径图片",
  "version": "0.1.0",
  "publisher": "tukwhy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tukwhy/md2pdf.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "md2pdf.export",
        "title": "MD2PDF: 导出为 PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "md2pdf.openPreview",
        "title": "MD2PDF: 打开分屏渲染预览",
        "icon": "$(open-preview)"
      },
      {
        "command": "md2pdf.openSettings",
        "title": "MD2PDF: 打开设置",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "md2pdf.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "md2pdf.export",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "md2pdf.export",
          "when": "editorLangId == markdown",
          "group": "1_modification@1"
        },
        {
          "command": "md2pdf.openPreview",
          "when": "editorLangId == markdown",
          "group": "1_modification@2"
        }
      ],
      "explorer/context": [
        {
          "command": "md2pdf.export",
          "when": "resourceExtname == .md",
          "group": "7_modification@1"
        }
      ]
    },
    "configuration": {
      "title": "MD2PDF 配置",
      "properties": {
        "md2pdf.cjkFont": {
          "type": "string",
          "default": "Microsoft YaHei",
          "description": "导出 PDF 的中文字体名称（如 Microsoft YaHei, SimSun, SimHei, KaiTi 等）"
        },
        "md2pdf.monoFont": {
          "type": "string",
          "default": "Consolas",
          "description": "代码块等宽字体名称（如 Consolas, Courier New）"
        },
        "md2pdf.margin": {
          "type": "string",
          "default": "2.2cm",
          "description": "页面边距（如 2.2cm, 2.5cm, 1in）"
        },
        "md2pdf.highlightStyle": {
          "type": "string",
          "default": "tango",
          "enum": [
            "tango",
            "pygments",
            "kate",
            "monokai",
            "zenburn",
            "espresso",
            "breezeDark"
          ],
          "description": "代码高亮语法主题"
        },
        "md2pdf.toc": {
          "type": "boolean",
          "default": false,
          "description": "是否在正文最前自动生成目录"
        },
        "md2pdf.customHeader": {
          "type": "string",
          "default": "",
          "description": "自定义 LaTeX Header 模板路径（若留空则使用内置的 template/header.tex）"
        },
        "md2pdf.openAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "导出 PDF 成功后是否自动调用系统阅读器打开"
        },
        "md2pdf.pandocPath": {
          "type": "string",
          "default": "pandoc",
          "description": "Pandoc 可执行文件路径（默认从系统环境变量 PATH 读取）"
        },
        "md2pdf.pdfEngine": {
          "type": "string",
          "default": "xelatex",
          "description": "PDF 渲染编译器（推荐使用 xelatex）"
        }
      }
    }
  },
  "dependencies": {
    "@iktakahiro/markdown-it-katex": "^4.0.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.2"
  }
}
